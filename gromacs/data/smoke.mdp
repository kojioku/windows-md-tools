; smoke test: 200 steps of a small water box, V-rescale + C-rescale
integrator      = md
nsteps          = 200
dt              = 0.002
cutoff-scheme   = Verlet
nstlist         = 20
coulombtype     = PME
rcoulomb        = 0.9
rvdw            = 0.9
tcoupl          = V-rescale
tc-grps         = System
tau-t           = 0.1
ref-t           = 300
pcoupl          = C-rescale
tau-p           = 2.0
ref-p           = 1
compressibility = 4.5e-5
constraints     = h-bonds
gen-vel         = yes
gen-temp        = 300
gen-seed        = 1
nstenergy       = 50
nstlog          = 50
